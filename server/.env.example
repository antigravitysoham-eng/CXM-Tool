# Copy to .env and fill in real values. Do NOT commit .env.

# Core server config
PORT=5000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h
# USD -> INR reference rate used for cross-currency roll-ups
FX_USD_INR=83

# Zoho CRM API Credentials
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here
ZOHO_DC=com # Change to eu, in, jp, etc. if different

# ---- Security ----
# Origins allowed to call this API. Leave empty in production: the server serves
# the built frontend from the same origin, so no cross-origin access is needed.
# In dev, point it at Vite: http://localhost:5173,http://localhost:5174
CORS_ORIGINS=

# Anyone who can reach the host can otherwise create their own account.
# Keep false in production; admins create users via Access & Users.
ALLOW_SELF_REGISTRATION=false
MIN_PASSWORD_LENGTH=10

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
# Raise this locally if running the full test suites — they exceed 600 from one IP.
RATE_LIMIT_AUTH_MAX=10

# Set true behind a reverse proxy/load balancer so rate limiting sees the real
# client IP from X-Forwarded-For instead of the proxy's.
TRUST_PROXY=false

# ---- Agent access ----
# How long an agent session lease survives without a request before another key
# for the same (user, agent identity) can take over. Guards against a crashed
# agent locking the identity out.
AGENT_LEASE_TTL_MS=90000

# ---- Hosting ----
# Serve the built SPA (../dist) from this process: one port, one container.
# Defaults to true when NODE_ENV=production.
SERVE_STATIC=

# ---- Data ----
# Absolute path to the SQLite file. Defaults to server/cx_tool.sqlite.
# In a container point this at the mounted volume so it survives restarts.
DB_PATH=

# ---- Document storage ----
# local = filesystem (server/storage), db = sqlite blobs (travels with the .db)
STORAGE_DRIVER=local

# ---- WhatsApp (Meta Cloud API) ----
# Lets users text prompts to a business number and get answers scoped to their
# access. All four are needed for a live channel; without TOKEN + PHONE_ID the
# feature is dormant (the webhook still 200s so Meta stops retrying).
#
# From Meta > WhatsApp > API Setup:
#   WHATSAPP_TOKEN         permanent/system-user access token for the Graph API
#   WHATSAPP_PHONE_ID      the "Phone number ID" messages are sent from
#   WHATSAPP_BUSINESS_NUMBER  the display number users text, e.g. +1 555 010 0000
# You choose these yourself:
#   WHATSAPP_VERIFY_TOKEN  any random string; paste the SAME value into Meta's
#                          webhook "Verify token" field
#   WHATSAPP_APP_SECRET    App > Settings > Basic > App Secret; used to verify the
#                          HMAC signature on every inbound webhook (leave empty in
#                          local dev to skip verification — never in production)
# Webhook callback URL to register in Meta:  https://<public-host>/api/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Graph API version (default v21.0)
WHATSAPP_GRAPH_VERSION=v21.0
